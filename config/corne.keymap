#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define NAV 1
#define SYM 2
#define ADJ 3
#define EXTRA 4

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <120>; /* tune to taste */
        };

        para: para {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_PARENTHESIS>, <&kp RIGHT_PARENTHESIS>;
        };

        caps: caps {
            compatible = "zmk,behavior-caps-word";
            #binding-cells = <0>;
            continue-list = <MINUS BACKSPACE>;
        };

        paraless: paraless {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp LEFT_PARENTHESIS>, <&kp LESS_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        paragreat: paragreat {
            compatible = "zmk,behavior-mod-morph";
            bindings = <&kp RIGHT_PARENTHESIS>, <&kp GREATER_THAN>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <180>;
            hold-trigger-key-positions = <6 7 8 9 10 11 20 18 19 20 21 22 23 32 30 31 32 33 34 35 39 40 41>;
            #hold-trigger-on-release;
        };

        hmr: homerow_mods_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <180>;
            require-prior-idle-ms = <180>;
            #hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 3>;
        };
    };

    macros {
        browsertab: browsertab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    combos { compatible = "zmk,combos"; };

    //

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";

            // -----------------------------------------------------------------------------------------
            // |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  |
            // |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |
            // |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp TAB     &kp Q  &kp W  &kp E          &kp R      &kp T             &kp Y  &kp U          &kp I      &kp O    &kp P     &kp RETURN
&kp ESCAPE  &kp A  &kp S  &kp D          &kp F      &kp G             &kp H  &kp J          &kp K      &kp L    &kp SEMI  &kp SQT
&kp LCTRL   &kp Z  &kp X  &kp C          &kp V      &kp B             &kp N  &kp M          &kp COMMA  &kp DOT  &kp FSLH  &kp DELETE
                          &kp RIGHT_ALT  &kp SPACE  &kp LEFT_SHIFT    &mo 1  &kp BACKSPACE  &mo 2
            >;
        };

        NavNum {
            display-name = "NavNum";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            // | GUI | CTRL | SHFT | LWR | SPC |   | ENT | RSE  | BKSP | ALT | ESC |

            bindings = <
&kp LS(NUMBER_6)   &kp LEFT_BRACE  &kp LS(N9)        &kp LS(NUMBER_0)   &kp RIGHT_BRACE   &kp UNDERSCORE    &kp EXCLAMATION  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp DOLLAR   &kp GRAVE
&kp LS(NUMBER_7)   &kp SLASH       &kp MINUS         &kp EQUAL          &kp PLUS          &kp STAR          &kp AT           &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp HASH     &trans
&kp LS(BACKSLASH)  &kp LESS_THAN   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GREATER_THAN  &kp BACKSLASH     &kp NUMBER_0     &kp NUMBER_1  &kp N2        &kp NUMBER_3  &kp PERCENT  &kp TILDE
                                                     &kp LEFT_WIN       &trans            &trans            &trans           &trans        &mo 3
            >;
        };

        Symbols {
            display-name = "Symbols";

            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&kp LS(NUMBER_6)  &kp LEFT_BRACE  &kp LS(NUMBER_9)  &kp LS(NUMBER_0)   &kp RIGHT_BRACE   &kp LS(MINUS)       &kp LS(NUMBER_1)  &kp PAGE_UP    &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT_ARROW)  &kp LC(HOME)
&kp LS(NUMBER_7)  &kp SLASH       &kp MINUS         &kp EQUAL          &kp LS(EQUAL)     &kp LS(NUMBER_8)    &kp LS(NUMBER_2)  &kp HOME       &kp LEFT_ARROW      &kp DOWN_ARROW  &kp RIGHT            &kp END
&kp PIPE          &kp LESS_THAN   &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GREATER_THAN  &kp BACKSLASH       &trans            &kp PAGE_DOWN  &kp LA(LEFT_ARROW)  &trans          &kp LA(RIGHT_ARROW)  &kp LC(END)
                                                    &kp LEFT_WIN       &trans            &trans              &mo 3             &trans         &mo 3
            >;
        };

        System {
            display-name = "System";
            bindings = <
&trans        &kp F1        &kp F2        &kp F3        &kp F4      &kp F5            &kp F6  &kp F7  &kp F8  &kp F9  &kp F10      &trans
&kp CAPSLOCK  &kp F11       &kp F12       &trans        &trans      &studio_unlock    &trans  &trans  &trans  &trans  &trans       &trans
&trans        &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &bt BT_CLR_ALL    &trans  &trans  &trans  &trans  &bootloader  &trans
                                          &trans        &trans      &trans            &trans  &trans  &trans
            >;
        };

        Extra {
            display-name = "Extra";
            bindings = <
&trans  &trans  &trans          &trans          &trans           &msc SCRL_UP      &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans          &mmv MOVE_UP    &trans           &msc SCRL_DOWN    &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &trans            &trans  &trans     &trans     &trans  &trans  &trans
                                &trans          &trans           &trans            &trans  &trans     &trans
            >;
        };
    };
};